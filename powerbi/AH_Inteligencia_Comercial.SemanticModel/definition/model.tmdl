ref table DimTienda
ref table 01_Medidas_Generales
ref table 02_Medidas_Rentabilidad
ref table 03_Medidas_Inventario
ref table 04_Medidas_Calidad
ref table 05_Medidas_Forecast

ref cultureInfo es-MX
